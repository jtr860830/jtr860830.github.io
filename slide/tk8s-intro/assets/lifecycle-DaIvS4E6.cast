[171.235288, "o", "[delete/units] remove the Quadlet units, the target and the routes unit\r\n  $ sudo -n rm -rf /etc/containers/systemd/demo /etc/systemd/system/demo.target /etc/systemd/system/demo-routes.service\r\n"]
[171.260852, "o", "  $ sudo -n systemctl daemon-reload\r\n"]
[171.811556, "o", "  $ sudo -n systemctl reset-failed 'demo*'\r\n"]
[171.851487, "o", "  $ sudo -n podman network exists demo\r\n"]
[171.951839, "o", "[delete/network] remove the podman network\r\n  $ sudo -n podman network rm -f demo\r\n"]
[172.053883, "o", "  $ sudo -n podman network exists demo\r\n"]
[172.144664, "o", "  $ ip route show 10.244.0.0/21\r\n"]
[172.14912, "o", "  $ ip route show 10.98.0.0/24\r\n"]
[172.153015, "o", "[delete/routes] already done\r\n[delete/state] remove the state directory, PVC data included\r\n"]
[172.153161, "o", "  $ sudo -n rm -rf /opt/taroko/clusters/demo\r\n"]
[172.179507, "o", "cluster demo deleted\r\n"]
