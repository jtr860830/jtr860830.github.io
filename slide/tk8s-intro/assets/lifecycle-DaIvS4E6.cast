[170.395106, "o", "  removed volume demo-worker-2-usr-local-bin\r\n  $ sudo -n podman volume exists demo-control-plane-1-var\r\n"]
[170.494453, "o", "  $ sudo -n podman volume exists demo-control-plane-1-etc\r\n"]
[170.588756, "o", "  $ sudo -n podman volume exists demo-control-plane-1-usr-local-bin\r\n"]
[170.682337, "o", "  $ sudo -n podman volume exists demo-worker-1-var\r\n"]
[170.773234, "o", "  $ sudo -n podman volume exists demo-worker-1-etc\r\n"]
[170.865914, "o", "  $ sudo -n podman volume exists demo-worker-1-usr-local-bin\r\n"]
