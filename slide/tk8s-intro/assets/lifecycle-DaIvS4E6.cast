{"version": 2, "width": 100, "height": 22, "timestamp": 1792320503, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "tk8s: stop, start, delete"}
[0.012897, "o", "\u001b[1;32mtux@tk8s:~$ \u001b[0mtkctl stop cluster demo\r\n"]
[1.759543, "o", "  $ sudo -n systemctl stop demo.target demo-router.service demo-control-plane-1.service demo-worker-1.service demo-worker-2.service\r\n"]
[40.505568, "o", "cluster demo stopped\r\n"]
[40.576114, "o", "\u001b[1;32mtux@tk8s:~$ \u001b[0mtkctl get clusters\r\n"]
[42.243722, "o", "NAME         NODES   K8S      DATAPATH  STATE     SUBNET\r\n"]
[42.267097, "o", "demo         1+2     1.37.1   netkit    Stopped   172.22.0.0/24\r\n"]
[42.327622, "o", "\u001b[1;32mtux@tk8s:~$ \u001b[0mtkctl start cluster demo\r\n"]
[44.010369, "o", "  $ sudo -n systemctl start demo.target\r\n"]
