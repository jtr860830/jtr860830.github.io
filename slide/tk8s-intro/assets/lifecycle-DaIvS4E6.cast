[71.23136, "o", "  demo-control-plane-1 Ready\r\n"]
[71.235223, "o", "  demo-worker-1 Ready\r\n  demo-worker-2 Ready\r\n"]
[71.295033, "o", "\u001b[1;32mtux@tk8s:~$ \u001b[0mkubectl get nodes\r\n"]
[72.824103, "o", "NAME                   STATUS   ROLES           AGE     VERSION\r\ndemo-control-plane-1   Ready    control-plane   7m45s   v1.37.1\r\ndemo-worker-1          Ready    <none>          7m31s"]
[72.83035, "o", "   v1.37.1\r\ndemo-worker-2          Ready    <none>          7m29s   v1.37.1\r\n\u001b[1;32mtux@tk8s:~$ \u001b[0mtkctl delete cluster demo --yes\r\n"]
[74.524519, "o", "  $ systemctl is-active --quiet demo.target\r\n"]
[74.543328, "o", "[delete/stop] stop the cluster target and its network unit\r\n  $ sudo -n systemctl disable --now demo.target\r\n"]
[74.605619, "o", "Removed '/etc/systemd/system/multi-user.target.wants/demo.target'.\r\r\n"]
[75.285346, "o", "  $ sudo -n systemctl stop demo-network.service\r\n"]
[167.42406, "o", "  $ systemctl is-active --quiet demo.target\r\n"]
[167.437501, "o", "  $ systemctl is-active --quiet demo-network.service\r\n"]
[167.450239, "o", "  $ sudo -n podman container exists demo-control-plane-1\r\n"]
[167.543333, "o", "  $ sudo -n podman container exists demo-worker-1\r\n"]
[167.633853, "o", "  $ sudo -n podman container exists demo-worker-2\r\n"]
[167.729152, "o", "  $ sudo -n podman container exists demo-router\r\n"]
[167.823374, "o", "[delete/containers] already done\r\n  $ sudo -n podman volume exists demo-control-plane-1-var\r\n"]
[167.914759, "o", "[delete/volumes] remove the node volumes (/var, /etc, /usr/local/bin of every node)\r\n  $ sudo -n podman volume exists demo-control-plane-1-var\r\n"]
[168.005887, "o", "  $ sudo -n podman volume rm -f demo-control-plane-1-var\r\n"]
[168.242449, "o", "  removed volume demo-control-plane-1-var\r\n  $ sudo -n podman volume exists demo-control-plane-1-etc\r\n"]
[168.343673, "o", "  $ sudo -n podman volume rm -f demo-control-plane-1-etc\r\n"]
[168.480158, "o", "  removed volume demo-control-plane-1-etc\r\n  $ sudo -n podman volume exists demo-control-plane-1-usr-local-bin\r\n"]
[168.581621, "o", "  $ sudo -n podman volume rm -f demo-control-plane-1-usr-local-bin\r\n"]
[168.765989, "o", "  removed volume demo-control-plane-1-usr-local-bin\r\n  $ sudo -n podman volume exists demo-worker-1-var\r\n"]
[168.856525, "o", "  $ sudo -n podman volume rm -f demo-worker-1-var\r\n"]
[169.059818, "o", "  removed volume demo-worker-1-var\r\n  $ sudo -n podman volume exists demo-worker-1-etc\r\n"]
