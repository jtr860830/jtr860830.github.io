[169.593096, "o", "  removed volume demo-worker-1-usr-local-bin\r\n  $ sudo -n podman volume exists demo-worker-2-var\r\n"]
[169.685756, "o", "  $ sudo -n podman volume rm -f demo-worker-2-var\r\n"]
[169.885862, "o", "  removed volume demo-worker-2-var\r\n  $ sudo -n podman volume exists demo-worker-2-etc\r\n"]
[169.97703, "o", "  $ sudo -n podman volume rm -f demo-worker-2-etc\r\n"]
[170.117049, "o", "  removed volume demo-worker-2-etc\r\n  $ sudo -n podman volume exists demo-worker-2-usr-local-bin\r\n"]
