{"version": 2, "width": 100, "height": 22, "timestamp": 1792320062, "env": {"SHELL": "/bin/bash", "TERM": "tmux-256color"}, "title": "tk8s: create cluster"}
[0.011025, "o", "\u001b[1;32mtux@tk8s:~$ \u001b[0mtkctl version\r\n"]
[1.667761, "o", "tkctl v2026.10.12\r\n"]
[1.67306, "o", "kubernetes default 1.37.1\r\n"]
[1.731832, "o", "\u001b[1;32mtux@tk8s:~$ \u001b[0mtkctl create cluster --list-phases\r\n"]
[3.39039, "o", "preflight          check the host: podman, systemd, cgroup v2, swap, sudo, sysctls, data tree\r\nplan               resolve cluster.yaml: defaults, subnet, node names\r\nimages             pull every image the cluster needs into the shared store\r\nunits              write the Quadlet units, the target, the routes and the router config\r\nnodes              start the nodes\r\n  cni-plugins        install the CNI plugins the nodes mount\r\n  up                 start the cluster target and wait for every node and the router\r\nkubeadm            initialise the first control plane and join the others\r\n  render             write the kubeadm init configuration into the state dir\r\n  frr                bgp mode: FRR and the VIP health timer on every control plane\r\n  init               kubeadm init on the first control plane\r\n  kubeconfig         hand the host a kubeconfig that points at the router (proxy) or the VIP (bgp)\r\n  join               join the other control planes and the workers\r\ncni                install the CNI and wait for the nodes\r\n  install            install the CNI (cilium: kube-proxy replacement, LB-IPAM, Gateway API)\r\n  nodes-ready        wait for every node to be Ready\r\naddons             RuntimeClass, gVisor, metrics-server, local-path\r\n  runtimeclass       RuntimeClass crun (CRI-O's default runtime)\r\n  gvisor             gVisor into every node and RuntimeClass gvisor (only with --gvisor)\r\n  metrics-server     metrics-server (kubectl top)\r\n  local-path         local-path-provisioner with PV data under the state dir\r\n"]
[6.452563, "o", "\u001b[1;32mtux@tk8s:~$ \u001b[0mtkctl create cluster demo --preset lab\r\n"]
[8.130916, "o", "[preflight] check the host: podman, systemd, cgroup v2, swap, sudo, sysctls, data tree\r\n  $ podman --version\r\n"]
[8.186476, "o", "  $ stat -fc %T /sys/fs/cgroup\r\n"]
[8.189118, "o", "  $ swapon --show --noheadings\r\n"]
[8.194477, "o", "  $ sudo -n true\r\n"]
[8.217377, "o", "  $ curl --version\r\n"]
[8.247747, "o", "  $ lsmod\r\n"]
[8.260609, "o", "  $ sudo -n sysctl -qw net.bridge.bridge-nf-call-iptables=0 net.bridge.bridge-nf-call-ip6tables=0\r\n"]
[8.283744, "o", "  $ sudo -n sysctl -qw net.ipv4.ip_forward=1\r\n"]
[8.305193, "o", "  $ sudo -n install -D -m 644 /dev/stdin /etc/modules-load.d/tk8s.conf\r\n"]
[8.330297, "o", "  $ sudo -n install -D -m 644 /dev/stdin /etc/sysctl.d/90-tk8s.conf\r\n"]
[8.353582, "o", "  $ id -u\r\n"]
[8.355917, "o", "  $ id -g\r\n"]
[8.358435, "o", "  $ id -un\r\n"]
[8.360918, "o", "  preflight ok: podman 5.4.2, systemd, cgroup v2, swap off, host bridge-nf off, ip_forward on, /opt/taroko owned by tux\r\n"]
[8.361291, "o", "[plan] resolve cluster.yaml: defaults, subnet, node names\r\n  preset lab: --control-planes 1 --workers 2 --ha proxy --routers 1\r\n  cluster demo: 1 control plane + 2 workers, K8s 1.37.1, subnet 172.22.0.0/24\r\n"]
