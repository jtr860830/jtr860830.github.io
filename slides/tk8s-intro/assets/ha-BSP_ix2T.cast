[229.453004, "o", "\u001b[1;32mtux@tk8s:~$ \u001b[0mtkctl describe cluster ha\r\n"]
[231.239182, "o", "Name:        ha\r\nState:       Running\r\nKubernetes:  1.37.1   cni: cilium   datapath: netkit   gvisor: false\r\nNetwork:     nodes 172.22.0.0/24 (gateway 172.22.0.254)  pods 10.244.0.0/21  services 10.98.0.0/24  lb-ipam 172.22.0.200-172.22.0.219  router 172.22.0.253  vip 172.23.0.1\r\nNodes:\r\n  NAME                     ROLE           IP             RESOURCES      JOIN\r\n  ha-control-plane-1       control-plane  172.22.0.1     2 cpu, 4g      joined\r\n  ha-control-plane-2       control-plane  172.22.0.2     2 cpu, 4g      joined\r\n  ha-control-plane-3       control-plane  172.22.0.3     2 cpu, 4g      joined\r\n  ha-worker-1              worker         172.22.0.4     2 cpu, 4g      joined"]
[231.239531, "o", "\r\n  ha-worker-2              worker         172.22.0.5     2 cpu, 4g      joined\r\n  ha-worker-3              worker         172.22.0.6     2 cpu, 4g      joined\r\nStatus:\r\n  phase:      Ready   (created by tk8s v2026.10.12-2-g909b5bd)\r\n  plan                   2026-10-18 11:07:03Z\r\n  units                  2026-10-18 11:07:08Z\r\n  nodes/up               2026-10-18 11:07:38Z\r\n  kubeadm/render         2026-10-18 11:07:38Z\r\n  kubeadm/frr            2026-10-18 11:07:49Z\r\n  kubeadm/init           2026-10-18 11:08:10Z\r\n  kubeadm/kubeconfig     2026-10-18 11:08:10Z\r\n  kubeadm/join           2026-10-18 11:09:17Z\r\n  cni/install            2026-10-18 11:10:15Z\r\n  addons/runtimeclass    2026-10-18 11:10:16Z\r\n"]
[231.239752, "o", "  addons/metrics-server  2026-10-18 11:10:39Z\r\n  addons/local-path      2026-10-18 11:10:51Z\r\nAddons:\r\n"]
[231.345134, "o", "  metrics-server  v0.9.0\r\n"]
[231.468902, "o", "  local-path      v0.0.37\r\n"]
[231.567942, "o", "  runtimeclass    crun\r\n"]
[231.568352, "o", "Router:\r\n  mode:     bgp (VyOS BGP AS 65000, ECMP over every control plane announcing the VIP)\r\n  address:  172.22.0.253 (api.ha.k8s -> 172.23.0.1, the VIP; VRRP floats it between the two routers)\r\n"]
[235.340511, "o", "  routers:  ha-router-1 172.22.0.251 MASTER, ha-router-2 172.22.0.252 BACKUP\r\n  shell:    sudo podman exec -it ha-router-1 vbash   (ha-router-2 likewise)\r\n  stop:     sudo systemctl stop ha-router-1.service   (podman stop would be restarted by systemd)\r\n"]
[236.13408, "o", "  peers:    ha-control-plane-1 Established, ha-control-plane-2 Established, ha-control-plane-3 Established (ha-router-1) / ha-control-plane-1 Established, ha-control-plane-2 Established, ha-control-plane-3 Established (ha-router-2)\r\n"]
[236.615304, "o", "  nexthops: 3 to 172.23.0.1 on ha-router-1, 3 on ha-router-2 (show ip route 172.23.0.1)\r\nAccess:"]
[236.615806, "o", "\r\n  apiserver:  https://172.23.0.1:6443 (anycast VIP; ha-router-1 and ha-router-2 spread it over the control planes announcing it)\r\n"]
[236.616051, "o", "  from this host:       LoadBalancer IPs (172.22.0.200-172.22.0.219) and ClusterIPs (10.98.0.0/24) are routed\r\n"]
[236.621386, "o", "  from another machine: sudo ip route add 172.22.0.0/24 via 192.168.1.230 && sudo ip route add 172.23.0.1/32 via 192.168.1.230   (and 10.98.0.0/24 for ClusterIPs)\r\nPaths:\r\n"]
[236.621751, "o", "  state:      /opt/taroko/clusters/ha/\r\n  kubeconfig: /opt/taroko/clusters/ha/kubeconfig\r\n  units:      /etc/containers/systemd/ha/   target: /etc/systemd/system/ha.target\r\n"]
