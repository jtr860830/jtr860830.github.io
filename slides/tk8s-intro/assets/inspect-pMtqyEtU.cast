[4.953493, "o", "\u001b[1;32mtux@tk8s:~$ \u001b[0mtkctl describe cluster demo\r\n"]
[6.66329, "o", "Name:        demo\r\nState:       Running\r\nKubernetes:  1.37.1   cni: cilium   datapath: netkit   gvisor: false\r\nNetwork:     nodes 172.22.0.0/24 (gateway 172.22.0.254)  pods 10.244.0.0/21  services 10.98.0.0/24  lb-ipam 172.22.0.200-172.22.0.219  router 172.22.0.253\r\nNodes:\r\n  NAME                     ROLE           IP             RESOURCES      JOIN\r\n"]
[6.663689, "o", "  demo-control-plane-1     control-plane  172.22.0.1     2 cpu, 4g      joined\r\n  demo-worker-1            worker         172.22.0.2     2 cpu, 4g      joined\r\n  demo-worker-2            worker         172.22.0.3     2 cpu, 4g      joined\r\nStatus:\r\n  phase:      Ready   (created by tk8s v2026.10.12)\r\n  plan                   2026-10-18 10:41:11Z\r\n"]
[6.664042, "o", "  units                  2026-10-18 10:41:15Z\r\n  nodes/up               2026-10-18 10:41:39Z\r\n  kubeadm/render         2026-10-18 10:41:39Z\r\n  kubeadm/init           2026-10-18 10:41:56Z\r\n  kubeadm/kubeconfig     2026-10-18 10:41:56Z\r\n  kubeadm/join           2026-10-18 10:42:07Z\r\n"]
[6.664245, "o", "  cni/install            2026-10-18 10:42:51Z\r\n  addons/runtimeclass    2026-10-18 10:42:52Z\r\n  addons/metrics-server  2026-10-18 10:43:15Z\r\n  addons/local-path      2026-10-18 10:43:27Z\r\nAddons:\r\n"]
[6.799631, "o", "  metrics-server  v0.9.0\r\n"]
[6.933173, "o", "  local-path      v0.0.37\r\n"]
[7.072945, "o", "  runtimeclass    crun\r\nRouter:\r\n  mode:     proxy (VyOS load-balancing haproxy, TCP check on every control plane)\r\n  address:  172.22.0.253 (api.demo.k8s resolves to it on every node)\r\n  shell:    sudo podman exec -it demo-router vbash\r\n"]
[7.87419, "o", "  backends: demo-control-plane-1 UP\r\nAccess:\r\n  apiserver:  https://172.22.0.253:6443 (VyOS haproxy in demo-router; every node and this host go through it)\r\n  from this host:       LoadBalancer IPs (172.22.0.200-172.22.0.219) and ClusterIPs (10.98.0.0/24) are routed\r\n"]
[7.878984, "o", "  from another machine: sudo ip route add 172.22.0.0/24 via 192.168.1.230   (and 10.98.0.0/24 for ClusterIPs)\r\nPaths:\r\n"]
[7.87937, "o", "  state:      /opt/taroko/clusters/demo/\r\n  kubeconfig: /opt/taroko/clusters/demo/kubeconfig\r\n  units:      /etc/containers/systemd/demo/   target: /etc/systemd/system/demo.target\r\n"]
[10.953827, "o", "\u001b[1;32mtux@tk8s:~$ \u001b[0mtkctl verify cluster demo\r\n"]
